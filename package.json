{
  "name": "tf2-editor",
  "version": "0.2.0",
  "description": "Level editor for Team Fortress 2: edits .vmf maps and runs the Hammer++ compile tools",
  "author": "Kelvin C",
  "license": "SEE LICENSE IN README.md",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test.js && node --test test/*.test.js",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "dockview-core": "^8.5.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "productName": "TF2 Editor",
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "TF2-Editor-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "TF2-Editor-Portable-${version}.${ext}"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "app.js",
      "vmf.js",
      "index.html",
      "style.css",
      "src/**/*",
      "build/icon.png",
      {
        "from": "node_modules/three/examples/jsm",
        "to": "node_modules/three/examples/jsm"
      }
    ]
  }
}
